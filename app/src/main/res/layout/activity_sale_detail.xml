<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/relative"
    tools:context=".add_room.detail_activity">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:id="@+id/image1"
            android:src="@drawable/ic_my_profile"
            android:layout_height="200sp"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:id="@+id/image2"
            android:src="@drawable/ic_my_profile"
            android:layout_height="200sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <TextView

            android:drawableStart="@drawable/ic_flat"
            android:layout_width="match_parent"
            android:layout_weight="6"
            android:layout_height="wrap_content"/>
        <TextView
            android:padding="5sp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:id="@+id/room_type"
            android:hint="room type"

            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <TextView
            android:padding="5sp"
            android:drawableStart="@drawable/ic_my_profile"
            android:layout_width="match_parent"
            android:layout_weight="6"
            android:layout_height="wrap_content"/>
        <TextView
            android:padding="5sp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:hint="Owner Name"
            android:id="@+id/owner_name"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <TextView
            android:padding="5sp"
            android:drawableStart="@drawable/ic_call"
            android:layout_width="match_parent"
            android:layout_weight="6"
            android:layout_height="wrap_content"/>
        <TextView
            android:padding="5sp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:hint="Phone"
            android:id="@+id/owner_phone"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <TextView
            android:padding="5sp"
            android:drawableStart="@drawable/ic_map"
            android:layout_width="match_parent"
            android:layout_weight="6"
            android:layout_height="wrap_content"/>
        <TextView
            android:padding="5sp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:hint="Address"
            android:id="@+id/address"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <TextView
            android:padding="5sp"
            android:drawableStart="@drawable/ic_flat"
            android:layout_width="match_parent"
            android:layout_weight="6"
            android:layout_height="wrap_content"/>
        <com.borjabravo.readmoretextview.ReadMoreTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/description"
            android:padding="8sp"
            app:trimExpandedText="Read More"
            app:trimCollapsedText="Less"
            android:layout_weight="1"
            app:trimMode="trimModeLength"
            android:hint="Description"
            app:trimLength="20"
            app:colorClickableText="@color/colorPrimary"
            android:textColor="@android:color/black" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <TextView
            android:padding="5sp"
            android:drawableStart="@drawable/ic_status"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <TextView
            android:padding="5sp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:hint="Address"
            android:id="@+id/status"
            android:layout_height="wrap_content"/>
        <Button
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:text="Sold"
            android:id="@+id/sold"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <fragment
        android:layout_width="match_parent"
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_height="200sp"/>
</LinearLayout>