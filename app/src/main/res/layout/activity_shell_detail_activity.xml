<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/relative"
    tools:context=".add_room.detail_activity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_marginStart="10sp"
                android:layout_marginEnd="10sp"
                app:cardCornerRadius="10sp"
                android:background="@drawable/border_line_for_button"
                android:layout_marginTop="10sp"
                android:elevation="3sp"
                android:layout_height="wrap_content">
                <com.smarteist.autoimageslider.SliderView
                    android:id="@+id/slider"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_centerInParent="true"
                    app:sliderAnimationDuration="600"
                    app:sliderAutoCycleDirection="back_and_forth"
                    app:sliderIndicatorAnimationDuration="600"
                    app:sliderIndicatorEnabled="true"
                    app:sliderIndicatorGravity="center_horizontal|bottom"
                    app:sliderIndicatorMargin="15dp"
                    app:sliderIndicatorOrientation="horizontal"
                    app:sliderIndicatorPadding="3dp"
                    app:sliderIndicatorRadius="2dp"
                    app:sliderIndicatorSelectedColor="#5A5A5A"
                    app:sliderIndicatorUnselectedColor="#FFF"
                    app:sliderScrollTimeInSec="1"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:background="#FEFCFF"
                android:layout_marginTop="210sp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginTop="30sp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginEnd="10sp"
                    android:layout_marginStart="10sp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/ic_rent"
                            android:layout_width="30sp"
                            android:layout_weight="6"
                            android:layout_height="30sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:textColor="@android:color/black"
                            android:id="@+id/room_type"
                            android:hint="room type"
                            android:fontFamily="@font/lato"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/ic_my_profile"
                            android:layout_width="30sp"
                            android:layout_height="30sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:hint="Owner Name"
                            android:textColor="@android:color/black"
                            android:id="@+id/owner_name"
                            android:fontFamily="@font/lato"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30sp"
                            android:layout_height="30sp"
                            android:padding="5sp"
                            android:src="@drawable/ic_mobile" />

                        <TextView
                            android:id="@+id/owner_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lato"
                            android:hint="Phone"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginTop="10sp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10sp"
                    android:layout_marginStart="10sp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/ic_map"
                            android:layout_width="30sp"
                            android:layout_height="30sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:hint="Address"
                            android:textColor="@android:color/black"
                            android:id="@+id/address"
                            android:fontFamily="@font/lato"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="30sp"
                            android:src="@drawable/ic_price"
                            android:layout_height="30sp">

                        </ImageView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:id="@+id/price"
                            android:hint="price"
                            android:fontFamily="@font/lato"
                            android:layout_height="wrap_content">

                        </TextView>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:padding="5sp"
                            android:src="@drawable/ic_status"
                            android:layout_width="30sp"
                            android:layout_height="30sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:hint="Address"
                            android:fontFamily="@font/lato"
                            android:textColor="@android:color/black"
                            android:id="@+id/status"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="10sp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10sp"
                    android:layout_marginTop="10sp"
                    android:layout_height="wrap_content">
                    <com.borjabravo.readmoretextview.ReadMoreTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/description"
                        android:padding="8sp"
                        android:fontFamily="@font/lato"
                        app:trimExpandedText="Read More"
                        app:trimCollapsedText="Less"
                        app:trimMode="trimModeLength"
                        android:hint="Description"
                        app:trimLength="20"
                        app:colorClickableText="@color/colorPrimary"
                        android:textColor="@android:color/black" />
                </LinearLayout>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_marginTop="10sp"
                    app:cardCornerRadius="10sp"
                    android:elevation="3sp"
                    android:layout_height="wrap_content">
                    <fragment
                        android:id="@+id/map"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="200sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>