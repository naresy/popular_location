<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:id="@+id/mainactivity"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20sp"
                    android:layout_marginLeft="20sp"
                    android:layout_marginTop="10sp"
                    android:layout_weight="1.5"
                    android:padding="5sp"
                    android:text="Name"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    app:fontFamily="@font/alegreya">

                </TextView>
                <EditText
                    android:layout_marginTop="10sp"
                    android:layout_width="match_parent"
                    android:id="@+id/help_name"
                    android:hint="Name"
                    android:autofillHints="name"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_marginTop="10sp"
                    android:layout_marginStart="20sp"
                    android:textStyle="bold"
                    android:padding="5sp"
                    android:textColor="@android:color/black"
                    android:layout_weight="1.5"
                    android:layout_width="match_parent"
                    android:text="Phone"
                    android:layout_height="wrap_content"
                    android:digits="10"
                    app:fontFamily="@font/alegreya"
                    android:layout_marginLeft="20sp">
                </TextView>
                <EditText
                    android:layout_marginTop="10sp"
                    android:layout_width="match_parent"
                    android:id="@+id/help_phone"
                    android:hint="Phone"
                    android:layout_weight="1"
                    android:inputType="phone"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_marginTop="10sp"
                    android:layout_marginStart="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_weight="1.5"
                    android:layout_width="match_parent"
                    android:text="Help Type"
                    app:fontFamily="@font/alegreya"
                    android:padding="5sp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20sp">
                </TextView>
                <EditText
                    android:layout_marginTop="10sp"
                    android:id="@+id/help_type_message"
                    android:textColor="@android:color/black"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:hint="Help Type"
                    android:layout_height="wrap_content">
                </EditText>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_marginTop="10sp"
                    android:layout_marginStart="20sp"
                    android:textStyle="bold"
                    android:padding="5sp"
                    android:id="@+id/get_address"
                    android:textColor="@android:color/holo_green_dark"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:text="Address"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20sp">
                </TextView>
                <TextView
                    android:layout_marginTop="10sp"
                    android:layout_width="match_parent"
                    android:id="@+id/help_address"
                    android:hint="latitude"
                    android:textSize="15sp"
                    android:textColor="@android:color/black"
                    android:layout_weight="1"
                    android:autofillHints="longitude"
                    android:inputType="phone"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_marginTop="10sp"
                    android:layout_width="match_parent"
                    android:id="@+id/help_address1"
                    android:hint="longitude"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textColor="@android:color/black"
                    android:inputType="phone"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">
                <TextView
                    android:layout_marginTop="10sp"
                    android:layout_marginStart="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_width="match_parent"
                    android:text="small message here--!"
                    android:textAlignment="center"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20sp"
                    android:gravity="center_horizontal">
                </TextView>
                <EditText
                    android:layout_marginTop="10sp"
                    android:layout_width="match_parent"
                    android:id="@+id/help_message"
                    android:hint="message"
                    android:layout_marginStart="20sp"
                    android:layout_marginEnd="10sp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10sp"
                    android:layout_marginLeft="20sp" />
            </LinearLayout>
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="50sp"
                android:id="@+id/pressed"
                android:layout_gravity="center"
                android:src="@drawable/ic_red_light"
                android:layout_height="50sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
