<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_form"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".login.login_activity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <pl.droidsonroids.gif.GifImageView
                android:layout_width="match_parent"
                android:layout_marginEnd="24sp"
                android:layout_marginStart="24sp"
                android:src="@drawable/login"
                android:layout_height="200sp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="  Email"
                android:layout_marginEnd="24sp"
                android:layout_marginStart="24sp"
                android:layout_marginTop="10sp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/register_user_email"
                    android:padding="10sp"
                    android:drawableStart="@drawable/ic_email_icon"
                    android:inputType="textEmailAddress"/>

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24sp"
                android:layout_marginStart="24sp"
                android:layout_marginTop="10sp"
                app:passwordToggleEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:hint="  Password">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/user_register_password"
                    android:fontFamily="@font/lato"
                    android:inputType="textPassword"
                    android:padding="10sp"
                    android:drawableStart="@drawable/ic_pass"/>

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forget Password ?"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:id="@+id/user_forget_password"
                android:fontFamily="@font/lato"
                android:layout_marginTop="5sp"
                android:padding="10sp"
                android:textSize="15sp"
                android:layout_marginStart="24sp"/>
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10sp"
                android:layout_marginStart="24sp"
                android:layout_marginEnd="24sp"
                android:background="@color/colorPrimary"
                android:text="Login"
                android:id="@+id/login_email"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/lato"
                android:textColor="@android:color/white"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:text="OR"
                android:textAlignment="center"
                android:layout_marginTop="10sp"
                android:fontFamily="@font/lato"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <com.facebook.login.widget.LoginButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1sp"
                    android:layout_marginStart="24sp"
                    android:paddingTop="11sp"
                    android:paddingBottom="11sp"
                    android:drawableStart="@drawable/ic_facebook"
                    android:text="Facebook"
                    android:layout_gravity="center"
                    android:fontFamily="@font/lato"
                    android:layout_weight="1">
                </com.facebook.login.widget.LoginButton>
                <com.google.android.gms.common.SignInButton
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5sp"
                    android:layout_marginEnd="24sp"
                    android:layout_height="wrap_content"/>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="center"
                    android:text="     Don't Have Account:"
                    android:fontFamily="@font/lato"
                    android:layout_marginTop="10sp"
                    android:layout_marginStart="24sp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="textStart"
                    android:text="Register Here"
                    android:fontFamily="@font/lato"
                    android:layout_marginTop="10sp"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:id="@+id/Register_here"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:padding="10sp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>























































































































