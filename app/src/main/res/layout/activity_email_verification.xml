<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/email_verify_layout"
        tools:context=".login.email_verification">
        <ImageView
            android:layout_width="100sp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="100sp"
            android:src="@drawable/ic_email_verify"
            android:id="@+id/bc"
            android:layout_height="150sp"/>
        <TextView
            android:layout_below="@+id/bc"
            android:textAlignment="center"
            android:id="@+id/cd"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:text="Please verify your email:"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />
        <TextView
            android:layout_below="@+id/cd"
            android:textAlignment="center"
            android:id="@+id/ad"
            android:textColor="@android:color/black"
            android:text=""
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <LinearLayout
            android:layout_below="@id/ad"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_verification_code_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email_verification_code"
                    android:hint="Code here"
                    android:layout_marginTop="10sp"
                    android:layout_marginLeft="20sp"
                    android:layout_marginRight="20sp"
                    android:inputType="number"
                    android:textColor="@android:color/black"
                    android:textAlignment="center"
                    android:textSize="15sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/email_verification"
                    android:text="Verify"
                    android:layout_marginTop="10sp"
                    android:layout_marginLeft="20sp"
                    android:layout_marginRight="20sp"
                    android:textColor="@android:color/black"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" />
                <TextView
                    android:id="@+id/email_verification_code_resend"
                    android:text="Resend code"
                    android:layout_marginTop="10sp"
                    android:layout_marginLeft="20sp"
                    android:layout_marginRight="20sp"
                    android:textColor="@android:color/black"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" />

            </LinearLayout>
            <TextView
                android:id="@+id/email_verification_time"
                android:text="timer"
                android:layout_marginTop="10sp"
                android:layout_marginLeft="20sp"
                android:layout_marginRight="20sp"
                android:textColor="@android:color/black"
                android:textAlignment="center"
                android:textSize="20sp"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal" />
        </LinearLayout>
    </RelativeLayout>




