<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fancy="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/user_profile_layout"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="250sp"
        android:background="@color/colorPrimary"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_profile_image"
            android:layout_width="150sp"
            android:layout_height="150sp"
            app:civ_border_width="2sp"
            app:civ_border_color="@android:color/white"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_my_profile" />

        <TextView
            android:id="@+id/user_fullname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@color/colorPrimary"
            android:fontFamily="@font/lato"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />


    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_marginStart="10sp"
        app:cardCornerRadius="10sp"
        android:layout_marginEnd="10sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="175sp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_marginTop="20sp"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/profile">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_marginStart="10sp"
                        android:src="@drawable/ic_profile"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginStart="10sp"
                        android:fontFamily="@font/lato"
                        android:text=" Detail Profile"
                        android:textColor="@color/colorPrimary"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/find_doc">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_doctor"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find Doctor"
                        android:fontFamily="@font/lato"
                        android:textSize="10sp"
                        android:textColor="@color/colorPrimary"/>

                </LinearLayout>

                <LinearLayout

                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/medical_doc">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_medical_report"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical Report"
                        android:textSize="10sp"
                        android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_marginStart="10sp"
                android:layout_marginTop="20sp"
                android:layout_height="wrap_content">

                <LinearLayout

                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/my_cart">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_add_cart"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Cart"
                        android:textSize="10sp"
                         android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>


                <LinearLayout

                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/my_order">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_my_order"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="My order"
                        android:textSize="10sp"
                        android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>



                </LinearLayout>

                <LinearLayout

                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/upload_room">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_rent"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uploaded room"
                        android:textSize="10sp"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10sp"
                android:layout_marginTop="20sp"
                android:orientation="horizontal">

                <LinearLayout

                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/upload_sale">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_sale_ic"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uploaded Sale"
                        android:textSize="10sp"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>

                <LinearLayout

                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/notification">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_notification_ic"
                        android:layout_height="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/notification_active"
                        android:text="notification"
                        android:textSize="10sp"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/card_change">

                    <ImageView

                        android:layout_width="40dp"
                        android:src="@drawable/ic_password"
                        android:layout_height="40dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="Change Password"
                        android:textSize="10sp"
                        android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>



                </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_marginStart="10sp"
                android:layout_marginTop="20sp"
                android:layout_height="wrap_content">
                <LinearLayout

                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/help">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_red_light"
                        android:layout_height="40dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:textSize="10sp"
                        android:text="Emergency"
                        android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/recent_activity">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_recent"
                        android:layout_height="40dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:text="Recent Activity"
                        android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/logout">

                    <ImageView
                        android:layout_width="40dp"
                        android:src="@drawable/ic_logout"
                        android:layout_height="40dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:text="Log out"
                        android:fontFamily="@font/lato"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>


            </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>




    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">






        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">





















                <!--Update User Details-->

            </LinearLayout>
        </ScrollView>

    </LinearLayout>







</RelativeLayout>
