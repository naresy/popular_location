<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/register"
    tools:context=".login.register">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <pl.droidsonroids.gif.GifImageView
                android:layout_width="match_parent"
                android:layout_height="200sp"
                android:layout_marginStart="24sp"
                android:layout_marginEnd="24sp"
                android:src="@drawable/login" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24sp"
                android:layout_marginTop="10sp"
                android:layout_marginEnd="24sp"
                android:hint="  Full Name ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/user_name_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_person_icon"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/lato"
                    android:padding="10sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24sp"
                android:layout_marginTop="10sp"
                android:layout_marginEnd="24sp"
                android:hint="  Email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/user_register_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_email_icon"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/lato"
                    android:padding="10sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24sp"
                android:layout_marginTop="10sp"
                android:layout_marginEnd="24sp"
                android:hint="  Password"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/user_password_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_pass"
                    android:fontFamily="@font/lato"
                    android:inputType="textPassword"
                    android:padding="10sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/Register_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24sp"
                android:layout_marginTop="10sp"
                android:layout_marginEnd="24sp"
                android:background="@color/colorPrimary"
                android:fontFamily="@font/lato"
                android:padding="10sp"
                android:text="SignUp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:fontFamily="@font/lato"
                android:text="OR"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.facebook.login.widget.LoginButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="24sp"
                    android:layout_marginTop="1sp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_facebook"
                    android:paddingTop="11sp"
                    android:paddingBottom="11sp"
                    android:fontFamily="@font/lato"
                    android:text="Facebook">

                </com.facebook.login.widget.LoginButton>

                <com.google.android.gms.common.SignInButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5sp"
                    android:layout_marginEnd="24sp"
                    android:layout_weight="1" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24sp"
                    android:layout_marginTop="10sp"
                    android:layout_weight="1"
                    android:fontFamily="@font/lato"
                    android:text="     Already Have Account:"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/login_here"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10sp"
                    android:layout_weight="1"
                    android:fontFamily="@font/lato"
                    android:padding="10sp"
                    android:text="Login Here"
                    android:textAlignment="textStart"
                    android:textColor="@color/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    </RelativeLayout>




